# New keys for /opt/blog/.env (append; nothing existing changes).
# Generate each on the box, never paste one from here.

# The one password for factory.bobbby.online. The release refuses to boot
# without it (config/runtime.exs).
#   openssl rand -base64 24
OBS_FACTOR_PASSWORD=

# Phoenix cookie signing.
#   openssl rand -base64 48
OBS_FACTOR_SECRET_KEY_BASE=

# The obs_factor Postgres role's password (deploy/postgres-role.sql).
# Hex only: it is interpolated into PG_URL without escaping.
#   openssl rand -hex 24
OBS_FACTOR_DB_PASSWORD=

# Optional. A healthchecks.io / Uptime Kuma push / Better Stack heartbeat
# URL, pinged every 60 s while the observer is healthy (deploy/WATCHDOG.md).
HEARTBEAT_URL=
# 1: an unhealthy observer POSTs <url>/fail (healthchecks.io, Better Stack).
HEARTBEAT_FAIL=
# get: for push URLs that only take GET (Uptime Kuma).
HEARTBEAT_METHOD=
