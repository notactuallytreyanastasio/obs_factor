# New keys for /opt/blog/.env (append; nothing existing changes).
# Generate each on the box, never paste one from here.

# The one password for factory.bobbby.online. The release refuses to boot
# without it (config/runtime.exs).
#   openssl rand -base64 24
OBS_FACTOR_PASSWORD=

# Phoenix cookie signing.
#   openssl rand -base64 48
OBS_FACTOR_SECRET_KEY_BASE=

# The obs_factor Postgres role's password (deploy/postgres-role.sql).
# Hex only: it is interpolated into PG_URL without escaping.
#   openssl rand -hex 24
OBS_FACTOR_DB_PASSWORD=

# Optional. Deploys (ObsFactor.Deploys): lets the observer ask GitHub for the
# subject of each deployed commit. A fine-grained personal access token,
# made by a human at github.com/settings/personal-access-tokens:
# repository access "Only select repositories" (blog, marginalia, tyler,
# dave, obs_factor; tyler is private), permission Contents: Read-only,
# nothing else. Empty: the sha alone.
OBS_FACTOR_GITHUB_TOKEN=
