# The observer's only door to the Docker Engine API.
#
# The raw socket is root on the host: anything that can POST to it can start a
# privileged container that mounts /. So this proxy forwards exactly three GET
# endpoints and answers 403 to everything else, including every other GET
# (logs, archive, export, top, changes, attach/ws, images, volumes, networks,
# info, events, plugins, system/df). An allowlist of paths, not of API
# sections: see the README for why tecnativa/docker-socket-proxy with
# CONTAINERS=1 is not enough.
#
#   GET /containers/json            list
#   GET /containers/{id}/json       inspect (carries every container's env!)
#   GET /containers/{id}/stats      stats (?stream=false for one sample)
#
# Container ids are hex and names are [a-zA-Z0-9][a-zA-Z0-9_.-]*; the first
# character can never be a dot, so ".." can never stand in for an id. The
# optional /v1.NN prefix is how Docker clients pin an API version.
#
# Used as-is by both the lab (lab/compose.yml mounts this file) and production
# (deploy/compose.obs-factor.yml mounts /opt/obs_factor/deploy/docker-proxy).

{
	admin off
	auto_https off
	log {
		output stdout
		format console
		level WARN
	}
}

:2375 {
	# Two checks on the path, because they see different strings. path_regexp
	# matches Caddy's cleaned, decoded path: /images/../containers/json
	# passes it, and the raw path is what is forwarded (Docker then answers
	# 301, verified, but the proxy should not depend on that). So the raw
	# request-URI, as the client sent it, must match too: no "..", no "//",
	# no percent-escapes, and a query of plain key=value pairs.
	@allowed {
		method GET
		path_regexp ^/(v1\.[0-9]+/)?containers/(json|[a-zA-Z0-9][a-zA-Z0-9_.-]*/(json|stats))$
		vars_regexp {http.request.orig_uri} ^/(v1\.[0-9]+/)?containers/(json|[a-zA-Z0-9][a-zA-Z0-9_-]*/(json|stats))(\?[a-zA-Z0-9_=&-]*)?$
	}

	handle @allowed {
		reverse_proxy unix//var/run/docker.sock {
			# stats?stream=true is an endless response: pass it through as written.
			flush_interval -1
		}
	}

	handle {
		header Content-Type application/json
		respond `{"message":"refused by obs_factor docker-proxy"}` 403
	}
}
