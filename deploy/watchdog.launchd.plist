<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs deploy/watchdog.sh once a minute on a Mac, as the logged-in user.
  launchd expands nothing: replace every /Users/YOU with your home directory
  (deploy/WATCHDOG.md has a sed line that does it), then
    cp deploy/watchdog.launchd.plist ~/Library/LaunchAgents/local.obs-factor.watchdog.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.obs-factor.watchdog.plist
  The webhook URL is a secret, so it is not in here: watchdog.sh reads it
  from ~/.config/obs-factor-watchdog/env (WATCHDOG_WEBHOOK=...).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.obs-factor.watchdog</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/YOU/.local/bin/obs-factor-watchdog.sh</string>
		<string>check</string>
	</array>

	<!-- every 60 s, and once at load so a fresh install shows a line at once -->
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/YOU/Library/Logs/obs-factor-watchdog.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Library/Logs/obs-factor-watchdog.log</string>

	<!-- a check is one curl with a 15 s limit; never let launchd throttle it as a crash loop -->
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
