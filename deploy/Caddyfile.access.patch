+
+# The access log the factory tails (obs_factor: deploy/Caddyfile.access).
+(access) {
+	log_append ua {header.User-Agent}
+	log_append country {header.Cf-Ipcountry}
+	log {
+		output file /var/log/caddy/access.log {
+			roll_size 50MiB
+			roll_keep 2
+			mode 0644
+		}
+		format filter {
+			wrap json
+			fields {
+				request>uri regexp "\?.*" ""
+				request>headers delete
+				request>remote_ip delete
+				request>remote_port delete
+				request>client_ip delete
+				request>tls delete
+				resp_headers delete
+				user_id delete
+			}
+		}
 	}
 }
 
