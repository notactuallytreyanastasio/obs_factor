# Only mix.exs, mix.lock, config/, lib/ and priv/ go into the image.
# Everything else is excluded so a lab state file, a secret or a build
# directory can never end up in a layer.
_build/
deps/
.git/
.github/
.elixir_ls/
.deciduous/
.claude/
.prs/
.env
.env.*
*.ez
erl_crash.dump
cover/
doc/
tmp/
test/
lab/
deploy/
deploy.sh
docs/
scripts/
node_modules/
README.md
AGENTS.md
CLAUDE.md
Dockerfile
.dockerignore

# lab/liveapp's image is built from this same context, because the app
# depends on packages/factory_report by path:
#   docker build -f lab/liveapp/Dockerfile -t obslab-liveapp .
# The same rule holds for it: source only, named file by named file.
!lab/liveapp/mix.exs
!lab/liveapp/mix.lock
!lab/liveapp/config
!lab/liveapp/lib
packages/*/*
!packages/*/mix.exs
!packages/*/lib
